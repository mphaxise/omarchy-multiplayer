#!/bin/bash
# proposed change for omarchy-multiplayer, 2026-09-01; diff against quattro

# omarchy:summary=Diagnose a crashed process with the default coding agent
# omarchy:args=<pid> [comm] [exe] [signal]
# omarchy:examples=omarchy agent crash 1516893

# Clicked from a "Process crashed:" notification, or run by hand against any PID
# in `coredumpctl list`. The method lives in the diagnose-crash skill so it is
# edited in one place and works with whichever agent is default; this only
# gathers the facts and points at it.

set -euo pipefail

pid=${1:?usage: omarchy-agent-crash <pid> [comm] [exe] [signal]}

if [[ ! $pid =~ ^[0-9]+$ ]]; then
  echo "Not a PID: $pid" >&2
  echo "Usage: omarchy agent crash <pid>   (see: coredumpctl list)" >&2
  exit 1
fi

comm=${2:-unknown}
exe=${3:-unknown}
signal=${4:-unknown}

skill="$OMARCHY_PATH/default/agents/skills/diagnose-crash/SKILL.md"

# Looked up live so a hand-run PID still gets a timestamp. A rotated-away core
# only costs the timestamp, so failure is tolerated.
when=$(coredumpctl list "$pid" --no-pager --no-legend 2>/dev/null | tail -1 | cut -d' ' -f1-4) || true
when=${when:-unknown}

prompt=$(
  cat <<PROMPT
A process crashed on this Omarchy machine and I want to know why.

What systemd-coredump recorded:
  process:  $comm
  PID:      $pid
  binary:   $exe
  signal:   $signal
  time:     $when

Use the diagnose-crash skill: it covers how to investigate, what to report, and
when a crash is worth reporting upstream to Omarchy. If your harness has no skill
mechanism, read the skill files directly and follow them instead:

  $skill
PROMPT
)

# Was: exec omarchy-agent --prompt "$prompt", one anonymous terminal per crash.
# Now: a receipted session, per 02-command-surface.md's wrapper section:
# "omarchy agent crash <pid> <comm> <exe> <signal> calls session new --name
# "crash-<pid>" --goal "diagnose crash of <comm> (pid <pid>)" with the built
# crash prompt forwarded the same way, then open." omarchy-agent has no flag
# to carry a name or goal through to `new`, so this calls
# omarchy-agent-session-core directly instead of delegating through it, which
# means the two small pieces of omarchy-agent's own logic that a crash launch
# still needs -- resolving the default agent kind, and the ~/Work cwd rule --
# are repeated here rather than inherited. Both are copied verbatim from
# bin/omarchy-agent below.

# Copied from omarchy-agent: agents refuse to remember trust for $HOME, so a
# launch from it starts in the work directory instead of re-asking every time.
# 07-worktrees.md: a crash session gets no worktree, "typically ~/Work, the
# same default omarchy-agent itself falls back to."
[[ $PWD == "$HOME" && -d $HOME/Work ]] && cd "$HOME/Work"

# Copied from omarchy-agent: `new --agent <kind>` is required
# (02-command-surface.md), and omarchy-agent is no longer in the call chain to
# resolve it, so this repeats that resolution rather than inventing a
# different one.
agent=$(omarchy-default-agent)
if [[ -z $agent ]]; then
  echo "Choose default agent with: omarchy default agent <name>" >&2
  exit 1
fi
if omarchy-cmd-missing "$agent"; then
  echo "$agent is not installed. Choose an installed agent with: omarchy default agent <name>" >&2
  exit 1
fi

# ASSUMPTION: mode defaults to personal here. Neither 02-command-surface.md's
# wrapper section nor 04-permission-modes.md states crash's mode explicitly;
# personal matches 04's stated default for "a keybinding launch" and a
# notification click is the same kind of act, a person present who just
# triggered it. Flagged in README-shell.md.
#
# ASSUMPTION: `session new` prints the new session's id to stdout on success
# (see bin/omarchy-agent.proposed for the same assumption, spelled out once).
session_id=$(omarchy-agent-session-core new \
  --agent "$agent" \
  --mode personal \
  --name "crash-$pid" \
  --goal "diagnose crash of $comm (pid $pid)" \
  --prompt "$prompt")
rc=$?
if ((rc != 0)); then
  exit "$rc"
fi
if [[ -z $session_id ]]; then
  echo "omarchy-agent-session-core new produced no session id" >&2
  exit 1
fi
exec omarchy-agent-session-core open "$session_id"
