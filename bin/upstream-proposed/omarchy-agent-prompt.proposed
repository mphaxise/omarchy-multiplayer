#!/bin/bash
# proposed change for omarchy-multiplayer, 2026-09-01; diff against quattro
#
# No functional change below: this script only forwards --prompt to
# omarchy-agent, and that is where the session-new-then-open change lives
# (see bin/omarchy-agent.proposed). Per 02-command-surface.md's wrapper
# section, "omarchy agent prompt <text> calls session new with <text>
# forwarded after -- ..., then open" is exactly what already happens once
# omarchy-agent itself is the proposed version, with zero edits needed here.
# Kept as its own reviewable copy, unchanged, so the pair stays easy to diff
# together.

# omarchy:summary=Launch the default coding agent with a prompt
# omarchy:args=[--inline] <prompt...>
# omarchy:examples=omarchy agent prompt "Review this project"

# Prompts live here rather than on `omarchy agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: omarchy agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec omarchy-agent "${inline[@]}" --prompt "$*"
