# omarchy-agent-session-watch.service
#
# Proposed for omarchy-multiplayer, 2026-09-01. Not installed by anything in
# this drafts tree; drafted for review against spec/06-notifications.md,
# which gives this unit's shape directly, and against the real
# omarchy-crash-watch.service (fetched from omacom/omarchy, branch quattro,
# 2026-09-01), which the task asked this unit to mirror.
#
# Copied from omarchy-crash-watch.service's actual shape, verbatim:
#   [Unit]    PartOf=graphical-session.target, After=graphical-session.target
#   [Service] Type=simple, Restart=always
#   [Install] WantedBy=graphical-session.target
#
# Deviations from crash-watch, and why, so a reviewer can see every one:
#
#   - RestartSec=2, not crash-watch's real RestartSec=5. The build task for
#     this file names 2s explicitly; crash-watch uses 5s. Followed the task's
#     2s here rather than silently matching crash-watch's 5s, but this is a
#     real discrepancy, not a settled decision -- VERIFY ON RIG whether 2s
#     restart is safe for this unit (a fast crash-loop would retry up to
#     ~30x/minute) or whether it should match crash-watch's 5s instead.
#
#   - ExecStart uses 06-notifications.md's own literal path,
#     %h/.local/share/omarchy/bin/omarchy-agent-session-watch, a per-user
#     path, rather than crash-watch's real ExecStart=/usr/bin/omarchy-crash-watch,
#     a system-wide one. This experiment's scripts are not packaged
#     system-wide in slice 1, so the user-local path is the one that matches
#     where bin/omarchy-agent-session-watch actually lives; flagged since the
#     task offered either "the path the spec implies" or a %h/.local/bin
#     alternative and this picks the spec's own literal path.
#
#   - Description is invented; neither the spec file nor the task names one.
#
#   - crash-watch's ConditionEnvironment=WAYLAND_DISPLAY and its
#     ConditionPathExists=!%h/.local/state/omarchy/toggles/crash-capture-off
#     are deliberately NOT carried over: neither is in the task's field list,
#     and 06-notifications.md names no equivalent toggle for session-watch.
#     A Wayland condition may still be warranted, since self-suppression and
#     the fullscreen quiet rule both read `hyprctl activewindow -j`
#     (06-notifications.md) and would need a compositor to mean anything --
#     VERIFY ON RIG whether this unit should gate on WAYLAND_DISPLAY the same
#     way crash-watch does.

[Unit]
Description=Notify on agent session state changes needing attention
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/share/omarchy/bin/omarchy-agent-session-watch
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
